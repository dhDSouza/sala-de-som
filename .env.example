# Copie para .env.local no desenvolvimento. Na Vercel, configure as variáveis
# em Project Settings > Environment Variables. Nunca publique senhas reais.

# PostgreSQL local (docker-compose.yml). Na Vercel, use a URL do banco externo.
DATABASE_URL="postgresql://playlist:playlist@localhost:5432/playlist"

# Gere um segredo aleatório de 32 caracteres ou mais; não use este exemplo.
SESSION_SECRET="A_LONG_AND_RANDOM_SECRET_KEY_FOR_SESSIONS"

# Gmail dedicado ao envio de confirmações de cadastro.
# Ative a verificação em duas etapas e gere uma senha de app no Google.
# SMTP_PASSWORD NÃO é a senha normal da conta. Sem SMTP, novos cadastros por senha ficam indisponíveis.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="SENHA_DE_APP_DO_GOOGLE"
SMTP_FROM="Sala de Som <seu-email@gmail.com>"

# Ative apenas na Vercel; ela fornece esse cabeçalho de IP.
# AUTH_IP_HEADER="x-vercel-forwarded-for"

# Opcional: login com Google (independente do Gmail SMTP acima).
# GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Desenvolvimento: localhost. Produção: URL HTTPS estável, por exemplo,
# APP_URL="https://seu-projeto.vercel.app"
APP_URL="http://localhost:3000"
# Opcional: primeiro administrador, apenas ao entrar com Google pela primeira vez.
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"

# Apenas Docker Compose local: altere também a senha em DATABASE_URL se usar.
# POSTGRES_PASSWORD="choose-a-local-password"
